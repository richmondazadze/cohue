# Server-only values. Populate in ignored .env.local or deployment secrets.
DATABASE_URL=
# Optional direct/unpooled migration connection; falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=
SERPAPI_API_KEY=
# Dedicated authorization for scheduler/worker, never a browser credential.
DISPATCHER_SECRET=
# Only this variable may be public. Use http://localhost:3000 for local development.
NEXT_PUBLIC_APP_URL=
# Backend must select and verify scheduled or worker dispatch before claiming D7.
DISPATCHER_MODE=
# Enable only after migration 0002 and all web/worker writers run compatible counter code.
# Keep 0 during rolling deployment; set 1 on both reviewed production runtimes afterward.
EVENT_RETENTION_READY=0
