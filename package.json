{
  "name": "cohue",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tests scripts *.ts *.mjs --no-warn-ignored --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check": "npm run check:foundation && npm run lint && npm run typecheck && npm test && npm run build",
    "contracts:export": "tsx scripts/export-contracts.ts",
    "handoff:append": "node scripts/append-handoff.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "tailwindcss": "4.3.3",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "motion": "14.6.0",
    "zustand": "5.0.16",
    "@tanstack/react-query": "5.104.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "@tailwindcss/postcss": "4.3.3",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
